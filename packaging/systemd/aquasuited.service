[Unit]
Description=AquasuiteLinux fan control service
Documentation=https://github.com/oreo1298/AquasuiteLinux
After=systemd-udevd.service

[Service]
Type=notify
ExecStart=/usr/bin/aquasuited
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
RuntimeDirectory=aquasuitelinux
RuntimeDirectoryMode=0755
ConfigurationDirectory=aquasuitelinux
LogsDirectory=aquasuitelinux
# Hardening. hidraw and /sys/class/hwmon must stay reachable.
ProtectSystem=strict
ReadWritePaths=/etc/aquasuitelinux /var/log/aquasuitelinux
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
